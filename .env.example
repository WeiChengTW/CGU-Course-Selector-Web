# MOOCS credentials are optional for local scripts.
# The web app login page asks users to enter these directly.
CGU_MOOCS_USER=
CGU_MOOCS_PASSWORD=

# Graduation analysis LLM API key.
# If the user enters an API key on /graduation, that value takes precedence.
CGU_LLM_API_KEY=

# CGU OpenAI-compatible LLM API settings.
LLM_BASE_URL=https://air.cgu.edu.tw/cgullmapi/v1
LLM_MODEL=gpt-5.4-mini
